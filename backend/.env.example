DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local (non-Docker) dev defaults to SQLite. Docker Compose overrides this
# with its own DATABASE_URL pointing at the "db" Postgres service. To use a
# local Postgres instead, replace this with:
#   postgres://parole:parole@localhost:5432/parole_visit_portal
DATABASE_URL=sqlite:///db.sqlite3

VISIT_GEOFENCE_RADIUS_METERS=150
RISK_LEVEL_LOW_MAX_CRIMES=2
RISK_LEVEL_MEDIUM_MAX_CRIMES=5
