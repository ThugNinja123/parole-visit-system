DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production (DEBUG=False) for admin/API POSTs behind the ALB domain.
CSRF_TRUSTED_ORIGINS=https://portal.example.com

# Local (non-Docker) dev defaults to SQLite. Docker Compose overrides this
# with its own DATABASE_URL pointing at the "db" Postgres service. On ECS,
# point this at the separate RDS instance instead, e.g.:
#   postgres://<user>:<password>@<rds-endpoint>:5432/<db-name>?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

VISIT_GEOFENCE_RADIUS_METERS=150
RISK_LEVEL_LOW_MAX_CRIMES=2
RISK_LEVEL_MEDIUM_MAX_CRIMES=5

# --- Container/ECS-only setting (see backend/docker-entrypoint.sh) ---
# Set to "true" to run `migrate` on container start. Leave "false" and run
# migrations as a one-off ECS task instead when running >1 replica, to avoid
# concurrent migration races.
RUN_DB_MIGRATIONS=false
